---
const { fotos } = Astro.props;
---

<div class="memorias-container">
	<div class="grid" id="memorias-grid">
		{
			fotos.map((foto, index) => (
				<div class="memoria-card" data-index={index}>
					<div class="card-inner">
						<div class="card-front">
							<div class="image-container">
								<img
									data-src={foto.src}
									alt={foto.titulo}
									class="lazy-image"
									loading="lazy"
									decoding="async"
								/>
								<div class="image-placeholder">
									<div class="placeholder-heart">💕</div>
									<div class="loading-spinner" />
								</div>
							</div>
							<div class="card-overlay">
								<div class="heart-icon">💕</div>
							</div>
						</div>
					</div>
				</div>
			))
		}
	</div>

	<!-- Modal para mostrar la memoria expandida -->
	<div class="modal-overlay" id="modal-overlay">
		<div class="modal-content" id="modal-content">
			<button class="close-btn" id="close-btn">
				<svg
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					xmlns="http://www.w3.org/2000/svg"
				>
					<path
						d="M18 6L6 18M6 6L18 18"
						stroke="currentColor"
						stroke-width="2"
						stroke-linecap="round"></path>
				</svg>
			</button>

			<div class="modal-card">
				<div class="modal-image">
					<img id="modal-img" src="" alt="" loading="eager" decoding="sync" />
					<div class="modal-image-loading" id="modal-loading">
						<div class="modal-spinner"></div>
					</div>
				</div>
				<div class="modal-info">
					<div class="modal-date" id="modal-date"></div>
					<h2 class="modal-title" id="modal-title"></h2>
					<p class="modal-message" id="modal-message"></p>
					<div class="decorative-hearts">
						<span>💕</span>
						<span>💖</span>
						<span>💕</span>
					</div>
				</div>
			</div>
		</div>
	</div>
</div>

<style>
	.memorias-container {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 2rem;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
		gap: 2rem;
		padding: 2rem 0;
	}

	@media (min-width: 768px) {
		.grid {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.memoria-card {
		perspective: 1000px;
		cursor: pointer;
		transition: transform 0.3s ease;
	}

	.memoria-card:hover {
		transform: translateY(-10px);
	}

	.card-inner {
		width: 100%;
		aspect-ratio: 1 / 1;
		position: relative;
		transform-style: preserve-3d;
		transition: all 0.6s cubic-bezier(0.4, 0, 0.2, 1);
		border-radius: 20px;
		box-shadow: 0 10px 30px rgba(255, 107, 157, 0.2);
		overflow: hidden;
	}

	.card-front {
		position: absolute;
		width: 100%;
		height: 100%;
		backface-visibility: hidden;
		border-radius: 20px;
		overflow: hidden;
		background: linear-gradient(45deg, #ffeef8, #fff0f5);
	}

	.image-container {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
	}

	.lazy-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: all 0.6s ease;
		opacity: 0;
		transform: scale(1.1);
	}

	.lazy-image.loaded {
		opacity: 1;
		transform: scale(1);
	}

	.lazy-image.error {
		opacity: 0.3;
	}

	.memoria-card:hover .lazy-image.loaded {
		transform: scale(1.1);
	}

	.image-placeholder {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(45deg, #ffeef8, #fff0f5);
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		transition: opacity 0.5s ease;
		overflow: hidden;
	}

	.image-placeholder::before {
		content: "";
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.4) 20%,
			rgba(255, 255, 255, 0.8) 50%,
			rgba(255, 255, 255, 0.4) 80%,
			transparent
		);
		animation: shimmer 2s infinite ease-in-out;
	}

	@keyframes shimmer {
		0% {
			left: -100%;
		}
		100% {
			left: 100%;
		}
	}

	.lazy-image.loaded + .image-placeholder {
		opacity: 0;
		pointer-events: none;
	}

	.placeholder-heart {
		font-size: 2rem;
		margin-bottom: 1rem;
		animation: placeholderPulse 2s ease-in-out infinite;
		z-index: 2;
		position: relative;
	}

	.loading-spinner {
		width: 30px;
		height: 30px;
		border: 3px solid rgba(255, 107, 157, 0.3);
		border-top: 3px solid #ff6b9d;
		border-radius: 50%;
		animation: spin 1s linear infinite;
		z-index: 2;
		position: relative;
	}

	/* Skeleton loading effect más avanzado */
	.memoria-card.loading .image-placeholder {
		background: linear-gradient(
			45deg,
			#f0f0f0 25%,
			transparent 25%,
			transparent 50%,
			#f0f0f0 50%,
			#f0f0f0 75%,
			transparent 75%,
			transparent
		);
		background-size: 20px 20px;
		animation: skeletonMove 2s linear infinite;
	}

	@keyframes skeletonMove {
		0% {
			background-position: 0 0;
		}
		100% {
			background-position: 20px 20px;
		}
	}

	/* Efecto de aparición suave cuando la imagen carga */
	.lazy-image {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
		opacity: 0;
		transform: scale(1.05);
		filter: blur(5px);
	}

	.lazy-image.loaded {
		opacity: 1;
		transform: scale(1);
		filter: blur(0px);
	}

	.lazy-image.error {
		opacity: 0.3;
		filter: grayscale(100%);
	}

	/* Efecto de respiración para el corazón */
	@keyframes placeholderPulse {
		0%,
		100% {
			opacity: 0.6;
			transform: scale(1);
		}
		50% {
			opacity: 1;
			transform: scale(1.15);
		}
	}

	@keyframes spin {
		0% {
			transform: rotate(0deg);
		}
		100% {
			transform: rotate(360deg);
		}
	}

	/* Variaciones del shimmer para diferentes elementos */
	.memoria-card:nth-child(even) .image-placeholder::before {
		animation-delay: 0.5s;
	}

	.memoria-card:nth-child(3n) .image-placeholder::before {
		animation-delay: 1s;
	}

	.memoria-card:nth-child(4n) .image-placeholder::before {
		animation-delay: 1.5s;
	}

	.card-overlay {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(
			45deg,
			rgba(255, 107, 157, 0.1),
			rgba(255, 138, 128, 0.1)
		);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 0;
		transition: opacity 0.3s ease;
	}

	.memoria-card:hover .card-overlay {
		opacity: 1;
	}

	.heart-icon {
		font-size: 3rem;
		filter: drop-shadow(0 4px 8px rgba(0, 0, 0, 0.2));
		animation: heartbeat 1.5s ease-in-out infinite;
	}

	@keyframes heartbeat {
		0%,
		100% {
			transform: scale(1);
		}
		50% {
			transform: scale(1.1);
		}
	}

	/* Modal Styles */
	.modal-overlay {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: rgba(0, 0, 0, 0.8);
		backdrop-filter: blur(10px);
		display: flex;
		align-items: center;
		justify-content: center;
		z-index: 1000;
		opacity: 0;
		visibility: hidden;
		transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.modal-overlay.active {
		opacity: 1;
		visibility: visible;
	}

	.modal-content {
		max-width: 90vw;
		max-height: 90vh;
		position: relative;
		transform: scale(0.8) translateY(50px);
		transition: transform 0.4s cubic-bezier(0.4, 0, 0.2, 1);
	}

	.modal-overlay.active .modal-content {
		transform: scale(1) translateY(0);
	}

	.close-btn {
		position: absolute;
		top: -50px;
		right: 0;
		background: rgba(255, 255, 255, 0.2);
		border: none;
		border-radius: 50%;
		width: 40px;
		height: 40px;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		color: white;
		transition: all 0.3s ease;
		backdrop-filter: blur(10px);
	}

	.close-btn:hover {
		background: rgba(255, 255, 255, 0.3);
		transform: scale(1.1);
	}

	.modal-card {
		background: white;
		border-radius: 25px;
		overflow: hidden;
		box-shadow: 0 25px 50px rgba(0, 0, 0, 0.3);
		display: flex;
		min-height: 400px;
		max-width: 800px;
		animation: modalSlideIn 0.6s cubic-bezier(0.4, 0, 0.2, 1);
	}

	@keyframes modalSlideIn {
		from {
			transform: rotateY(-90deg);
			opacity: 0;
		}
		to {
			transform: rotateY(0deg);
			opacity: 1;
		}
	}

	.modal-image {
		flex: 1;
		position: relative;
		overflow: hidden;
	}

	.modal-image img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transition: opacity 0.3s ease;
	}

	.modal-image-loading {
		position: absolute;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background: linear-gradient(45deg, #ffeef8, #fff0f5);
		display: flex;
		align-items: center;
		justify-content: center;
		opacity: 1;
		transition: opacity 0.5s ease;
		overflow: hidden;
	}

	.modal-image-loading::before {
		content: "";
		position: absolute;
		top: 0;
		left: -100%;
		width: 100%;
		height: 100%;
		background: linear-gradient(
			90deg,
			transparent,
			rgba(255, 255, 255, 0.3) 20%,
			rgba(255, 255, 255, 0.6) 50%,
			rgba(255, 255, 255, 0.3) 80%,
			transparent
		);
		animation: shimmer 2.5s infinite ease-in-out;
	}

	.modal-image-loading.hidden {
		opacity: 0;
		pointer-events: none;
	}

	.modal-spinner {
		width: 40px;
		height: 40px;
		border: 4px solid rgba(255, 107, 157, 0.3);
		border-top: 4px solid #ff6b9d;
		border-radius: 50%;
		animation: spin 1s linear infinite;
		z-index: 2;
		position: relative;
	}

	.modal-info {
		flex: 1;
		padding: 3rem;
		background: linear-gradient(135deg, #ffeef8 0%, #fff0f5 50%, #fce4ec 100%);
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
		position: relative;
	}

	.modal-date {
		color: #ff6b9d;
		font-size: 0.9rem;
		font-weight: 600;
		text-transform: uppercase;
		letter-spacing: 1px;
		margin-bottom: 0.5rem;
		opacity: 0.8;
	}

	.modal-title {
		font-size: 2rem;
		color: #333;
		margin-bottom: 1rem;
		font-family: "Georgia", serif;
		background: linear-gradient(45deg, #ff6b9d, #ff8a80);
		-webkit-background-clip: text;
		-webkit-text-fill-color: transparent;
	}

	.modal-message {
		color: #666;
		line-height: 1.8;
		font-size: 1.1rem;
		margin-bottom: 2rem;
		font-style: italic;
	}

	.decorative-hearts {
		display: flex;
		justify-content: center;
		gap: 1rem;
		font-size: 1.5rem;
		animation: gentleFloat 3s ease-in-out infinite;
	}

	.decorative-hearts span:nth-child(2) {
		animation-delay: 0.5s;
	}

	.decorative-hearts span:nth-child(3) {
		animation-delay: 1s;
	}

	@keyframes gentleFloat {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(-10px);
		}
	}

	/* Responsive Design */
	@media (max-width: 768px) {
		.modal-card {
			flex-direction: column;
			max-width: 95vw;
			max-height: 95vh;
		}

		.modal-info {
			padding: 2rem 1.5rem;
		}

		.modal-title {
			font-size: 1.5rem;
		}

		.modal-message {
			font-size: 1rem;
		}

		.close-btn {
			top: -40px;
			right: 10px;
		}
	}

	/* Floating hearts animation for background */
	.memorias-container::before {
		content: "";
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		bottom: 0;
		background-image: radial-gradient(
				circle at 20% 80%,
				rgba(255, 107, 157, 0.1) 0%,
				transparent 50%
			),
			radial-gradient(
				circle at 80% 20%,
				rgba(255, 138, 128, 0.1) 0%,
				transparent 50%
			),
			radial-gradient(
				circle at 40% 40%,
				rgba(252, 228, 236, 0.1) 0%,
				transparent 50%
			);
		pointer-events: none;
		z-index: -1;
	}
</style>

<script>
	// Script para manejar la funcionalidad del modal y lazy loading
	document.addEventListener("DOMContentLoaded", function () {
		const fotos = [
			{
				src: "/images/foto1.jpg",
				titulo: "Cirque du Soleil, Orlando",
				mensaje:
					"Un evento que culmino un dia lleno de alegria, cuando creia que nada iba a mejorar dicho dia, ese circo fue como la cereza a un pastel exquisito. Nuestro primer circo fue un momento inigualable para nosotros.",
				fecha: "5 de Abril, 2025",
			},
			{
				src: "/images/foto2.jpg",
				titulo: "Sea World, Orlando",
				mensaje:
					"Sea World Orlando fue un viaje inolvidable, donde pudimos ver animales increibles y disfrutar de la naturaleza marina. Nuestro recuerdo de este lugar esta lleno de experiencias nuevas y emocionantes.",
				fecha: "6 de Abril, 2025",
			},
			{
				src: "/images/foto3.jpg",
				titulo: "Animal Kingdom lodge, Orlando",
				mensaje:
					"Ese momento fue parte de una travesia inolvidable, precisamente este momento fue hermoso, ya que vimos animales exoticos y disfrutamos de la naturaleza",
				fecha: "5 de Abril, 2025",
			},
			{
				src: "/images/foto4.jpg",
				titulo: "Primer cita en el parque",
				mensaje:
					"Hay demasiado que decir de este dia, pero mis palabras han de limitarse. Tu presencia en mi vida ha sido una experiencia inolvidable, y ahora estoy aqui para recordarlas toda mi existencia. Todo lo que tenemos hoy, fue gracias a lo que construimos ese primer dia.",
				fecha: "26 de Noviembre, 2024",
			},
			{
				src: "/images/foto5.jpg",
				titulo: "Museo de ciencias, Planetario",
				mensaje:
					"En ese momento aprendimos cosas nuevas, y a pesar de que a ti no te apasiona tanto el espacio como a mi, tuvimos un momento agradable, donde ambos nos divertimos conociendo nuestro universo.",
				fecha: "10 de Mayo, 2025",
			},
			{
				src: "/images/foto6.jpg",
				titulo: "Museo de ciencias, Acuario",
				mensaje:
					"Aunque no fue nuestro primer acuario, me diverti mucho en ese momento experimentando algo nuevo, ya que tocamos animales marinos, se sintio raro, pero es bueno probar nuevas cosas.",
				fecha: "10 de Mayo, 2025",
			},
			{
				src: "/images/foto7.jpg",
				titulo: "El mejor cumpleaños de mi vida",
				mensaje:
					"De los mejores dias de mi vida, la pase demasiado bien, tanto que en la noche no paraba de expresar lo hermoso que me hiciste sentir, fue un dia que jamas olvidare, siempre lo recordare y gritare a voces que ese cumpleaños es el mejor de mi vida, y todo gracias a ti. Muchas gracias por eso, mi amor.",
				fecha: "11 de Mayo, 2025",
			},
			{
				src: "/images/foto8.jpg",
				titulo: "Flamingo Gardens, Fort Lauderdale",
				mensaje:
					"Un dia muy hermoso, donde conectamos con la naturaleza, vimos animales nuevos y aprendimos cosas sobre la naturaleza y el comportamiento de ciertos animales, esta foto es muy iconica y me gusto mucho.",
				fecha: "26 de Abril, 2025",
			},
			{
				src: "/images/foto9.jpg",
				titulo: "San Valentín",
				mensaje:
					"Rosas rojas y chocolate, pero tu sonrisa era el regalo más dulce. Ese día me atreví a decirte cuánto te amo.",
				fecha: "14 de Febrero, 2024",
			},
			{
				src: "/images/foto10.jpg",
				titulo: "Jardín de primavera",
				mensaje:
					"Flores de cerezo caían como confeti rosa. Dijiste que era mágico, pero la verdadera magia eras tú.",
				fecha: "22 de Marzo, 2024",
			},
			{
				src: "/images/foto11.jpg",
				titulo: "Feria del pueblo",
				mensaje:
					"Algodón de azúcar, juegos y tu mano en la mía. Ganaste ese oso de peluche que aún guardas con cariño.",
				fecha: "10 de Mayo, 2024",
			},
			{
				src: "/images/foto12.jpg",
				titulo: "Atardecer en la montaña",
				mensaje:
					"Subimos hasta la cima para ver el mundo desde arriba. Pero la vista más hermosa eras tú a mi lado.",
				fecha: "3 de Julio, 2024",
			},
			{
				src: "/images/foto13.jpg",
				titulo: "Cocina en casa",
				mensaje:
					"Harina por todas partes y risas sin parar. Quemamos las galletas, pero creamos el recuerdo más dulce.",
				fecha: "20 de Agosto, 2024",
			},
			{
				src: "/images/foto14.jpg",
				titulo: "Biblioteca secreta",
				mensaje:
					"Entre libros antiguos y luz dorada encontramos nuestro rincón especial. Leíste poemas mientras yo me perdía en tus ojos.",
				fecha: "5 de Octubre, 2024",
			},
			{
				src: "/images/foto15.jpg",
				titulo: "Mercado navideño",
				mensaje:
					"Luces cálidas, canela en el aire y tu mano en la mía. El invierno nunca fue tan acogedor como contigo.",
				fecha: "8 de Diciembre, 2024",
			},
			{
				src: "/images/foto16.jpg",
				titulo: "Nuestro lugar favorito",
				mensaje:
					"Volvimos al café donde todo comenzó. Mismas sonrisas, mismo amor, pero ahora más fuerte que nunca.",
				fecha: "14 de Enero, 2025",
			},
		];

		// Cache de imágenes cargadas
		const imageCache = new Map();

		// Precargar imágenes críticas (primeras 4)
		const preloadCriticalImages = () => {
			fotos.slice(0, 4).forEach((foto) => {
				const link = document.createElement("link");
				link.rel = "preload";
				link.as = "image";
				link.href = foto.src;
				document.head.appendChild(link);
			});
		};

		// Función para cargar imagen con lazy loading y efectos
		const loadImage = (img, src) => {
			return new Promise((resolve, reject) => {
				// Verificar cache primero
				if (imageCache.has(src)) {
					img.src = src;
					// Pequeño delay para mostrar la transición suave
					setTimeout(() => {
						img.classList.add("loaded");
						resolve();
					}, 100);
					return;
				}

				// Agregar clase de loading a la tarjeta
				const card = img.closest(".memoria-card");
				if (card) card.classList.add("loading");

				// Crear nueva imagen para precargar
				const tempImg = new Image();

				tempImg.onload = () => {
					imageCache.set(src, true);
					img.src = src;

					// Simular un pequeño delay para mostrar el efecto de carga
					// (puedes remover esto si quieres que sea instantáneo)
					setTimeout(() => {
						img.classList.add("loaded");
						if (card) card.classList.remove("loading");
						resolve();
					}, 300); // 300ms para ver el efecto shimmer
				};

				tempImg.onerror = () => {
					img.classList.add("error");
					if (card) card.classList.remove("loading");
					reject();
				};

				// Simular carga lenta para desarrollo (remover en producción)
				// setTimeout(() => {
				//     tempImg.src = src;
				// }, Math.random() * 1000 + 500);

				tempImg.src = src;
			});
		};

		// Intersection Observer para lazy loading
		const imageObserver = new IntersectionObserver(
			(entries, observer) => {
				entries.forEach((entry) => {
					if (entry.isIntersecting) {
						const img = entry.target;
						const src = img.dataset.src;

						loadImage(img, src).catch(() => {
							console.warn(`Failed to load image: ${src}`);
						});

						observer.unobserve(img);
					}
				});
			},
			{
				rootMargin: "50px 0px", // Cargar 50px antes de que sea visible
				threshold: 0.1,
			}
		);

		// Observar todas las imágenes lazy
		const lazyImages = document.querySelectorAll(".lazy-image");
		lazyImages.forEach((img) => {
			imageObserver.observe(img);
		});

		// Variables del modal
		const cards = document.querySelectorAll(".memoria-card");
		const modal = document.getElementById("modal-overlay");
		const modalImg = document.getElementById("modal-img");
		const modalTitle = document.getElementById("modal-title");
		const modalMessage = document.getElementById("modal-message");
		const modalDate = document.getElementById("modal-date");
		const modalLoading = document.getElementById("modal-loading");
		const closeBtn = document.getElementById("close-btn");

		// Abrir modal al hacer click en una tarjeta
		cards.forEach((card, index) => {
			card.addEventListener("click", () => {
				const foto = fotos[index];

				// Mostrar modal inmediatamente
				modal.classList.add("active");
				document.body.style.overflow = "hidden";

				// Actualizar información de texto inmediatamente
				modalTitle.textContent = foto.titulo;
				modalMessage.textContent = foto.mensaje;
				modalDate.textContent = foto.fecha;

				// Mostrar loading y cargar imagen
				modalLoading.classList.remove("hidden");
				modalImg.style.opacity = "0";

				// Cargar imagen del modal con efecto mejorado
				const loadModalImage = () => {
					// Crear imagen temporal para precargar
					const tempImg = new Image();

					tempImg.onload = () => {
						modalImg.src = foto.src;
						modalImg.alt = foto.titulo;

						// Efecto de aparición suave
						setTimeout(() => {
							modalImg.style.opacity = "1";
							modalImg.style.transform = "scale(1)";
							modalImg.style.filter = "blur(0px)";
							modalLoading.classList.add("hidden");
						}, 150);
					};

					tempImg.onerror = () => {
						modalLoading.classList.add("hidden");
						console.warn(`Failed to load modal image: ${foto.src}`);
					};

					// Preparar imagen modal para la transición
					modalImg.style.opacity = "0";
					modalImg.style.transform = "scale(1.1)";
					modalImg.style.filter = "blur(10px)";
					modalImg.style.transition = "all 0.6s cubic-bezier(0.4, 0, 0.2, 1)";

					tempImg.src = foto.src;
				};

				loadModalImage();
			});
		});

		// Cerrar modal
		const closeModal = () => {
			modal.classList.remove("active");
			document.body.style.overflow = "auto";
		};

		closeBtn.addEventListener("click", closeModal);

		// Cerrar modal al hacer click en el overlay
		modal.addEventListener("click", (e) => {
			if (e.target === modal) {
				closeModal();
			}
		});

		// Cerrar modal con la tecla Escape
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && modal.classList.contains("active")) {
				closeModal();
			}
		});

		// Precargar imágenes críticas al cargar la página
		preloadCriticalImages();

		// Precargar próximas imágenes cuando el usuario interactúe
		let interactionStarted = false;
		const startPreloading = () => {
			if (interactionStarted) return;
			interactionStarted = true;

			// Precargar el resto de imágenes gradualmente
			fotos.slice(4).forEach((foto, index) => {
				setTimeout(() => {
					const tempImg = new Image();
					tempImg.src = foto.src;
					imageCache.set(foto.src, true);
				}, index * 200); // 200ms entre cada precarga
			});
		};

		// Iniciar precarga en primer hover o scroll
		document.addEventListener("scroll", startPreloading, { once: true });
		document.addEventListener("mouseover", startPreloading, { once: true });
		document.addEventListener("touchstart", startPreloading, { once: true });
	});
</script>
