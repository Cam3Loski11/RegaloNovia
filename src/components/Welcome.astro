---
import Particles from "./Particles.astro";
import RomanticSwiper from "./RomanticSwiper";
import BirthdayCard from "./BirthdayCard.astro";
import PuzzleRomantico from "./Puzzle.jsx";
---

<div id="container">
	<!-- Banner romántico de cumpleaños -->
	<div class="birthday-banner">
		<div class="banner-content">
			<div class="floating-hearts">
				<span class="heart heart-1">💖</span>
				<span class="heart heart-2">✨</span>
				<span class="heart heart-3">💕</span>
				<span class="heart heart-4">🌹</span>
				<span class="heart heart-5">💖</span>
			</div>
			<h1 class="banner-title">Un Día Especial Para Ti</h1>
			<p class="banner-subtitle">
				Celebrando otro año de amor y momentos únicos
			</p>
		</div>
	</div>

	<!-- Contenedor principal -->
	<div class="layout-wrapper">
		<div class="side-border"></div>
		<div class="content">
			<!-- <Particles /> -->

			<!-- Sección del Puzzle -->
			<section class="puzzle-section">
				<div class="section-header">
					<h2 class="section-title">Este es Tu Regalo Especial</h2>
					<div class="title-decoration">
						<span class="decoration-heart">💝</span>
					</div>
				</div>
				<PuzzleRomantico client:load />
			</section>

			<!-- Sección del Carrusel -->
			<section class="carousel-section">
				<div class="section-header">
					<h2 class="section-title">Recuerdos de Amor</h2>
					<div class="title-decoration">
						<span class="decoration-heart">📸</span>
					</div>
				</div>
				<RomanticSwiper client:load />
			</section>

			<!-- Sección de la Carta -->
			<section class="letter-section">
				<div class="section-header">
					<h2 class="section-title">Una Carta Para Ti</h2>
					<div class="title-decoration">
						<span class="decoration-heart">💌</span>
					</div>
				</div>
				<BirthdayCard />
			</section>
		</div>
		<div class="side-border"></div>
	</div>
</div>

<style>
	/* Banner de cumpleaños */
	.birthday-banner {
		background: linear-gradient(
			135deg,
			#ff9bb2 0%,
			#ff7b95 25%,
			#ff5983 50%,
			#ff7b95 75%,
			#ff9bb2 100%
		);
		padding: 3rem 2rem;
		text-align: center;
		position: relative;
		overflow: hidden;
		box-shadow: 0 4px 20px rgba(255, 89, 131, 0.3);
	}

	.banner-content {
		position: relative;
		z-index: 2;
		max-width: 800px;
		margin: 0 auto;
	}

	.banner-title {
		font-size: 3rem;
		font-weight: 700;
		color: white;
		margin-bottom: 1rem;
		text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
		font-family: "Pacifico", cursive;
		animation: titleGlow 3s ease-in-out infinite alternate;
	}

	.banner-subtitle {
		font-size: 1.2rem;
		color: rgba(255, 255, 255, 0.95);
		font-weight: 300;
		text-shadow: 1px 1px 2px rgba(0, 0, 0, 0.1);
		font-style: italic;
	}

	.floating-hearts {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		pointer-events: none;
	}

	.heart {
		position: absolute;
		font-size: 2rem;
		animation: float 6s ease-in-out infinite;
		opacity: 0.8;
	}

	.heart-1 {
		top: 20%;
		left: 10%;
		animation-delay: 0s;
	}
	.heart-2 {
		top: 60%;
		left: 85%;
		animation-delay: 1s;
	}
	.heart-3 {
		top: 80%;
		left: 15%;
		animation-delay: 2s;
	}
	.heart-4 {
		top: 30%;
		left: 80%;
		animation-delay: 3s;
	}
	.heart-5 {
		top: 10%;
		left: 70%;
		animation-delay: 4s;
	}

	/* Layout principal */
	.layout-wrapper {
		display: flex;
		z-index: 1;
		min-height: calc(100vh - 200px);
		background: linear-gradient(135deg, #fff0f5 0%, #ffe4e1 100%);
	}

	.side-border {
		width: 60px;
		background-image: url("/flower-border.png");
		background-repeat: repeat-y;
		background-size: contain;
		background-position: center;
		flex-shrink: 0;
		opacity: 0.4;
	}

	.content {
		display: flex;
		justify-content: center;
		flex-direction: column;
		align-items: center;
		flex: 1;
		min-height: 100%;
		position: relative;
		z-index: 1;
		padding: 3rem 2rem;
		font-family: "Poiret One", sans-serif;
		gap: 4rem;
	}

	/* Secciones */
	section {
		width: 100%;
		max-width: 1200px;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 2rem;
	}

	.section-header {
		text-align: center;
		position: relative;
		margin-bottom: 1rem;
	}

	.section-title {
		font-size: 2.5rem;
		font-weight: 600;
		color: #ff5983;
		margin: 0;
		font-family: "Pacifico", cursive;
		text-shadow: 1px 1px 3px rgba(255, 89, 131, 0.2);
		position: relative;
	}

	.title-decoration {
		margin-top: 0.5rem;
	}

	.decoration-heart {
		font-size: 1.5rem;
		animation: bounce 2s infinite;
	}

	/* Secciones específicas */
	.puzzle-section {
		background: rgba(255, 255, 255, 0.6);
		border-radius: 20px;
		padding: 2rem;
		box-shadow: 0 8px 32px rgba(255, 89, 131, 0.1);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 255, 255, 0.2);
	}

	.carousel-section {
		background: rgba(255, 182, 193, 0.1);
		border-radius: 20px;
		padding: 2rem;
		box-shadow: 0 8px 32px rgba(255, 105, 180, 0.15);
		backdrop-filter: blur(5px);
		border: 1px solid rgba(255, 182, 193, 0.2);
	}

	.letter-section {
		background: rgba(255, 240, 245, 0.8);
		border-radius: 20px;
		padding: 2rem;
		box-shadow: 0 8px 32px rgba(255, 89, 131, 0.1);
		backdrop-filter: blur(10px);
		border: 1px solid rgba(255, 240, 245, 0.3);
	}

	/* Animaciones */
	@keyframes titleGlow {
		0% {
			text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
		}
		100% {
			text-shadow:
				2px 2px 8px rgba(0, 0, 0, 0.3),
				0 0 15px rgba(255, 255, 255, 0.3);
		}
	}

	@keyframes float {
		0%,
		100% {
			transform: translateY(0px) rotate(0deg);
		}
		25% {
			transform: translateY(-20px) rotate(5deg);
		}
		50% {
			transform: translateY(-10px) rotate(-5deg);
		}
		75% {
			transform: translateY(-15px) rotate(3deg);
		}
	}

	@keyframes bounce {
		0%,
		20%,
		50%,
		80%,
		100% {
			transform: translateY(0);
		}
		40% {
			transform: translateY(-10px);
		}
		60% {
			transform: translateY(-5px);
		}
	}

	/* Responsive Design - Samsung S23 y móviles */
	@media (max-width: 768px) {
		.banner-title {
			font-size: 2.2rem;
		}

		.banner-subtitle {
			font-size: 1rem;
		}

		.birthday-banner {
			padding: 2rem 1rem;
		}

		.side-border {
			display: none;
		}

		.content {
			padding: 2rem 1rem;
			gap: 3rem;
		}

		.section-title {
			font-size: 2rem;
		}

		.puzzle-section,
		.carousel-section,
		.letter-section {
			padding: 1.5rem;
			border-radius: 15px;
		}

		.heart {
			font-size: 1.5rem;
		}
	}

	/* Samsung S23 específico (393x851px) */
	@media (max-width: 400px) and (max-height: 900px) {
		.banner-title {
			font-size: 1.8rem;
			line-height: 1.2;
		}

		.banner-subtitle {
			font-size: 0.9rem;
		}

		.birthday-banner {
			padding: 1.5rem 0.8rem;
		}

		.content {
			padding: 1.5rem 0.8rem;
			gap: 2.5rem;
		}

		.section-title {
			font-size: 1.6rem;
		}

		.puzzle-section,
		.carousel-section,
		.letter-section {
			padding: 1rem;
			border-radius: 12px;
		}

		.heart {
			font-size: 1.2rem;
		}

		.floating-hearts .heart {
			opacity: 0.6;
		}
	}

	/* Landscape móvil */
	@media (max-height: 500px) and (orientation: landscape) {
		.birthday-banner {
			padding: 1rem;
		}

		.banner-title {
			font-size: 1.5rem;
		}

		.banner-subtitle {
			font-size: 0.8rem;
		}

		.content {
			gap: 2rem;
		}

		.section-title {
			font-size: 1.4rem;
		}
	}
</style>
